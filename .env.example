# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored so your secrets are NEVER committed.

# ------------------------------------------------------------------
# OpenAI  (the "brain + voice" of our patient bot: Realtime API)
# ------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# The Realtime (speech-to-speech) GA model. If this name is rejected, check
# https://platform.openai.com/docs/models for the current realtime model id.
OPENAI_REALTIME_MODEL=gpt-realtime
# Which OpenAI voice our "patient" speaks with (alloy, echo, shimmer, etc.)
PATIENT_VOICE=alloy

# ------------------------------------------------------------------
# Anthropic  (the "judge" that grades each call transcript in analyzer.py)
# We use a DIFFERENT model to grade than the one that speaks, so the voice
# model isn't grading itself.
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
JUDGE_MODEL=claude-sonnet-5

# ------------------------------------------------------------------
# Twilio  (the phone line: places the real call + streams the audio)
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The ONE Twilio number you bought. This is the single number you must report
# in the submission form (in E.164 format, e.g. +18165551234).
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Pretty Good AI's assessment line. DO NOT change this.
TEST_AGENT_NUMBER=+18054398008

# ------------------------------------------------------------------
# Public tunnel (ngrok) so Twilio can reach your laptop's server
# ------------------------------------------------------------------
# Just the host, no "https://" and no trailing slash.
# Example: abc123.ngrok-free.app
PUBLIC_HOSTNAME=your-subdomain.ngrok-free.app

# ------------------------------------------------------------------
# Local server
# ------------------------------------------------------------------
PORT=5050
